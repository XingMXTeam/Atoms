{
  "version": 1,
  "host": "claude-code",
  "stack": "nextjs",
  "gateCommands": [
    "pnpm typecheck",
    "pnpm lint",
    "pnpm test",
    "pnpm build"
  ],
  "budgets": {
    "maxMacroCycles": 5,
    "maxTaskRetries": 3
  },
  "autoStop": {
    "requiredStablePasses": 2
  },
  "evaluation": {
    "passScore": 0.9,
    "commandTimeoutMs": 120000
  },
  "git": {
    "requireCommitPerTask": true
  },
  "evidence": {
    "requireVerify": true
  }
}
