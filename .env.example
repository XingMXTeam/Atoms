# Copy to .dev.vars for local Next/Wrangler, and set CF secrets for production.
# Never commit real keys.

# Gemini API key (server-side only; never expose to the browser)
GEMINI_API_KEY=

# LLM provider mode:
#   gemini  — live Gemini REST streaming (production)
#   mock    — deterministic fixtures for unit/e2e tests
#   replay  — automatic fallback on Gemini error/quota; labelled "演示回放"
LLM_PROVIDER=mock

# Model routing (REQ-8): Flash for Planner/Architect, Pro for Engineer.
# Override when Google renames ids; defaults are current Flash/Pro-class.
GEMINI_MODEL_FLASH=gemini-2.0-flash
GEMINI_MODEL_PRO=gemini-2.0-pro

# Global daily token budget across all devices (soft cap → replay)
DAILY_TOKEN_CAP=500000

# Per anonymous deviceId daily run limit
DEVICE_DAILY_RUN_LIMIT=20
