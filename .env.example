# Copy to .dev.vars for local Next/Wrangler, and set CF secrets for production.
# Never commit real keys.

# Gemini API key (server-side only; never expose to the browser)
GEMINI_API_KEY=

# LLM provider mode:
#   gemini  — platform keys for the one-shot demo, or a visitor key when sent
#   mock    — deterministic fixtures for unit/e2e tests (no platform keys)
#   replay  — labelled "演示回放"; does not call platform models
LLM_PROVIDER=mock

# Model routing (REQ-8): Flash for Planner/Architect, Pro for Engineer.
# Override when Google renames ids; defaults are current cost-optimized Flash-class.
GEMINI_MODEL_FLASH=gemini-3.1-flash-lite
GEMINI_MODEL_PRO=gemini-3.8-flash

# Platform DeepSeek key. Used only on the one platform demo generation,
# as a fallback if Gemini fails. Never used to rescue a visitor (BYOK) call.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Legacy counters. They are no longer the platform billing gate.
DAILY_TOKEN_CAP=500000
DEVICE_DAILY_RUN_LIMIT=20

# Platform-key budget only. BYOK usage does not consume these.
# One full generation per deviceId, then the visitor must bring a key.
# Defaults are far below the old 500k/day soft cap.
PLATFORM_DEMO_GENERATIONS=1
PLATFORM_DAILY_TOKEN_CAP=50000
PLATFORM_MONTHLY_TOKEN_CAP=300000

# Cloudflare Turnstile for the platform-key demo path.
# Site key is public (wrangler var). Secret is `wrangler secret put` only.
# If the secret is empty, the demo path fails closed and mock/replay still run.
# Clearing the deviceId cookie mints a new id; Turnstile plus these caps
# are extra brakes, not a claim that the demo is bot-proof.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# The in-app cap is not a substitute for a low Google AI/Cloud billing budget
# with disable-on-threshold on the project that owns GEMINI_API_KEY.
# Do the same for the platform DeepSeek key if you keep one.

# Optional production Sandbox Container bridge (Dockerfile.sandbox: tsc + Vitest + Playwright)
SANDBOX_BRIDGE_URL=
SANDBOX_BRIDGE_TOKEN=
