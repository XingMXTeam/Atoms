# Production Atoms Backend Execution & Intelligent Reviewer Sandbox Container.
# Supports both Cloudflare Containers / @cloudflare/sandbox and standalone Docker hosts
# (Fly.io, Railway, VPS). Exposes HTTP `/health`, `/verify` (tsc), and `/review`
# (Playwright Chromium interactive journeys + isolated Vitest boundary tests).
FROM mcr.microsoft.com/playwright:v1.56.0-noble

WORKDIR /app/sandbox-server

# Pre-install TypeScript, React, Vitest, Testing Library, esbuild, and Playwright API
# (exact 1.56.0 matching the pre-installed Chromium in the base image).
COPY sandbox-server/package.json ./package.json
RUN PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 npm install --no-audit --no-fund

COPY sandbox-server/server.mjs ./server.mjs
COPY public/preview /app/public/preview

ENV NODE_ENV=production \
    PORT=8787 \
    ATOMS_PREVIEW_ASSETS_DIR=/app/public/preview

EXPOSE 8787

CMD ["node", "server.mjs"]
