{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "atoms-demo",
	"main": ".open-next/worker.js",
	"compatibility_date": "2025-11-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	// Gemini REST is blocked from some CF regions (e.g. HKG); pin to us-east-1.
	"placement": {
		"region": "aws:us-east-1"
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"routes": [
		{
			"pattern": "atoms.maoxunxing.com",
			"custom_domain": true
		}
	],
	"vars": {
		"LLM_PROVIDER": "gemini",
		// Platform-key demo only. BYOK does not consume these caps.
		// TURNSTILE_SITE_KEY is public. TURNSTILE_SECRET_KEY is already
		// set with `wrangler secret put` — never commit the secret.
		// Also set a low Google billing budget with disable-on-threshold.
		"TURNSTILE_SITE_KEY": "0x4AAAAAAGXQ0ckSFOEclMo3",
		"PLATFORM_DEMO_GENERATIONS": "1",
		"PLATFORM_DAILY_TOKEN_CAP": "50000",
		"PLATFORM_MONTHLY_TOKEN_CAP": "300000"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "atoms-demo",
			"database_id": "410cb3f4-2cb9-4c4a-bf31-d9b73768a694",
			"migrations_dir": "migrations"
		}
	]
}